# Break-glass admin login (Authorization: Bearer, or /?token=...). Users log in with passkeys.
MCP_TOKEN=change-me
# Password for the bundled Postgres (users, logins, tokens)
POSTGRES_PASSWORD=change-me-too
# Comma-separated admin emails; the first one is the bootstrap admin that MCP_TOKEN logs in as
ADMIN_EMAILS=
# 1 = anyone can create an account with a passkey (each gets a private library)
SIGNUP=0
# Cloudflare Turnstile on the signup form (recommended with SIGNUP=1; off when empty)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# 1 = behind your own reverse proxy (Caddy profile): take the client IP from X-Forwarded-For
TRUSTED_PROXY=0
# limits for non-admins
MAX_MODELS_PER_USER=100
MAX_DISK_MB_PER_USER=500
# Sign in with Google / GitHub / Apple (a provider shows up when its values are set).
# Redirect URI to register with each: https://<your-domain>/auth/sso/<google|github|apple>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Apple: the Services ID, team id, key id and the .p8 key's PEM text
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
PUBLIC_URL=https://stl.example.com
# 1 = web interface and STL files can be viewed without a token (changes still require a token)
UI_PUBLIC=0
FILES_PUBLIC=0
ALLOW_SCRIPT=0
# 0 = no OAuth for claude.ai connectors (needs PUBLIC_URL on https)
OAUTH=1
# Donate button in the header: your PayPal.me link or hosted-button URL (https only; hidden when empty)
DONATE_URL=
